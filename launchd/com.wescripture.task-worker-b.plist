<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wescripture.task-worker-b</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/reify/Classified/wescripture/launchd/run_task_worker.sh</string>
    <string>WorkerB</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/reify/Classified/wescripture</string>

  <!-- Run every 10 minutes — workers exit immediately if no tasks pending -->
  <key>StartInterval</key>
  <integer>600</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/reify/Classified/wescripture/diagnostics/task-worker-b.out</string>

  <key>StandardErrorPath</key>
  <string>/Users/reify/Classified/wescripture/diagnostics/task-worker-b.err</string>
</dict>
</plist>
