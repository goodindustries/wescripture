# Local/dev defaults (do not use in production as-is).
APP_ENV=local

# App/API
SESSION_SECRET=dev-insecure-change-me
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Postgres (Compose defaults)
POSTGRES_DB=wescripture
POSTGRES_USER=wescripture
POSTGRES_PASSWORD=wescripture

# Optional override if not using the Compose Postgres service
# DATABASE_URL=postgresql://wescripture:wescripture@localhost:5432/wescripture

# Backups
RETENTION_DAYS=14
BACKUP_CRON=0 3 * * *
